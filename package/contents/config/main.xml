<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0                           http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="">
    <entry name="CubeFaceDisplacement" type="Double">
      <default>100</default>
      <min>-500</min>
      <max>500</max>
    </entry>
    <entry name="DistanceFactor" type="Double">
      <default>1.75</default>
    </entry>
    <entry name="BorderActivate" type="String">
      <default/>
    </entry>
    <entry name="TouchBorderActivate" type="String">
      <default/>
    </entry>
    <entry name="MouseInvertedX" type="Bool">
      <default>false</default>
    </entry>
    <entry name="MouseInvertedY" type="Bool">
      <default>false</default>
    </entry>
    <entry name="SkyBox" type="Url"/>
    <entry name="BackgroundVideo" type="Url">
      <!-- Background == Video only: a local clip (file:). It is painted
                 exactly like an image, so it reuses BackgroundImageLayout,
                 BackgroundImageFit and BackgroundImageRotate below. Requires
                 the optional QtMultimedia module (package qt6-multimedia);
                 without it the colour fallback is painted instead. -->
      <default/>
    </entry>
    <entry name="Background" type="Enum">
      <default>Color</default>
      <choices>
        <!-- Index 1 keeps its kwinrc value: it used to be named SkyBox.
                     Video is APPENDED as index 3 so the stored 0/1/2 keep
                     meaning Color/Image/Gradient. -->
        <choice name="Color"/>
        <choice name="Image"/>
        <choice name="Gradient"/>
        <choice name="Video"/>
      </choices>
    </entry>
    <entry name="BackgroundImageLayout" type="Enum">
      <!-- How the picture wraps the scene (ADR-013). Auto was removed
                 because QML cannot probe the image ratio without decoding it.
                 The KEY is new on purpose: kwinrc stores the index, so an old
                 BackgroundImageMapping=1 (Equirect under the former
                 0=Auto, 1=Equirect, 2=Flat order) is orphaned and ignored
                 instead of being reinterpreted as Flat. Old values stay
                 untouched in kwinrc; constants.js treats any unknown value as
                 Equirect. Shared by the image and the video (Video wraps the
                 scene the same way: 360 panorama or flat clip). -->
      <default>Equirect</default>
      <choices>
        <choice name="Equirect"/>
        <choice name="Flat"/>
      </choices>
    </entry>
    <entry name="BackgroundImageFit" type="Enum">
      <!-- Only used by the Flat mapping: how the picture or clip fills the
                 screen (the video uses it too). -->
      <default>Cover</default>
      <choices>
        <choice name="Cover"/>
        <choice name="Contain"/>
        <choice name="Stretch"/>
      </choices>
    </entry>
    <entry name="BackgroundImageRotate" type="Bool">
      <!-- Equirect only: true wraps the scene (SkyBox) and turns with the
                 centre, false paints it flat. Shared by the image and the video. -->
      <default>true</default>
    </entry>
    <entry name="BackgroundColor" type="Color">
      <default>#1b3fd8</default>
    </entry>
    <entry name="BackgroundColor2" type="Color">
      <default>#ff8a00</default>
    </entry>
    <entry name="BackgroundGradientType" type="Enum">
      <default>LinearVertical</default>
      <choices>
        <choice name="LinearVertical"/>
        <choice name="LinearHorizontal"/>
        <choice name="Radial"/>
      </choices>
    </entry>
    <entry name="BackgroundGradientStop" type="Int">
      <default>50</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="BackgroundGradientRotation" type="Enum">
      <!-- Only the Gradient hull uses this (ADR-017): whether the
                 gradient turns with the cube (Fixed keeps it still). The
                 radial variant cannot turn around its centre, so it moves the
                 focal point instead (see HullGradient.qml). -->
      <default>Fixed</default>
      <choices>
        <choice name="Fixed"/>
        <choice name="FollowCube"/>
        <choice name="FollowCubeInverse"/>
      </choices>
    </entry>
    <!-- Face transparency (ADR-021): material opacity of every face, so
             the future cylinder mesh inherits it unchanged. 0.1 floor: an
             invisible face cannot be picked or clicked. -->
    <entry name="FaceOpacity" type="Double">
      <default>1</default>
      <min>0.1</min>
      <max>1</max>
    </entry>
    <entry name="FaceRotationOpacity" type="Double">
      <default>0.7</default>
      <min>0.1</min>
      <max>1</max>
    </entry>
    <entry name="FaceFadeMs" type="Int">
      <default>120</default>
      <min>0</min>
      <max>1000</max>
    </entry>
    <!-- Advanced tab only (ADR-014): these keys do not appear anywhere else. -->
    <entry name="DimWhileRotating" type="Bool">
      <default>false</default>
    </entry>
    <entry name="DimWhileRotatingAmount" type="Int">
      <default>40</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="CursorScreenOnly" type="Bool">
      <default>false</default>
    </entry>
    <!-- DebugOverlay (ADR-023): on-screen diagnostic text. console.log and
             supportInformation never reach a visible place in this KWin
             (doc/trucos-aprendidos.md section D), so the state is painted. -->
    <entry name="DebugOverlay" type="Bool">
      <default>false</default>
    </entry>
    <!-- Shape (ADR-025/ADR-026): Polygon = flat faces on an N-gon;
             Cylinder = the same faces as arcs on a cylinder (drum
             R = N(W+g)/2pi, theta = W/R, 64 segments). With 1-2 desktops
             Polygon keeps the flat sheet (ADR-024); Cylinder shows the
             drum with THREE slots — R = 3(W+g)/2pi with the user gap,
             faces at azimuths 0 and 120, the slots without a desktop
             empty (the hull shows through) and the turn range open,
             exactly like the closed drum (the capped [-60,60]/[-60,180]
             band was tried and retired by the user). Stored as the
             integer index in kwinrc. Appended last: the convention for
             new entries, so the stored indexes of existing keys never
             move. -->
    <entry name="Shape" type="Enum">
      <default>Polygon</default>
      <choices>
        <choice name="Polygon"/>
        <choice name="Cylinder"/>
      </choices>
    </entry>
    <!-- Caps (ADR-027): the top and bottom closing surfaces of the solid,
             enabled separately. Enums are stored as INTEGER indexes in kwinrc
             (a string value breaks the KCM environment); CapOpacity is an Int
             0-100 like DimWhileRotatingAmount, constants.js capOpacity()
             converts it to 0..1. CapImage accepts local resources only (file:
             or bare paths, same filter as the background image): the
             compositor must not fetch content when the effect activates. The
             polygon cap's apothem is the live faceDistance and the disc's
             radius the live cylinderRadius (2.2 of doc/requerimientos.md), so
             there is no parallel radius key here. Appended last: the
             convention for new entries, so the stored indexes of existing
             keys never move. -->
    <entry name="CapTop" type="Bool">
      <default>false</default>
    </entry>
    <entry name="CapBottom" type="Bool">
      <default>false</default>
    </entry>
    <!-- Arrow (3) is the DEFAULT because a uniform colour cannot show
             orientation: with a flat cap the user cannot tell "the cap is
             turned" from "the cap paints over the faces" (ADR-027
             amendment 2). The asymmetric marker (arrow + magenta corner
             quadrant) makes rotation and mirroring readable at a glance and
             is what makes the bottom cap's mirror testable in
             cap pixel gate, removed for cost (doc/trucos-aprendidos.md, section P). Appended at the END of the
             choices: KConfigXT stores the integer index, so existing keys
             never move (the project's enum rule). Unknown kwinrc values
             still fall back to Color through constants.js capContent(). -->
    <entry name="CapContent" type="Enum">
      <default>Arrow</default>
      <choices>
        <choice name="Color"/>
        <choice name="Gradient"/>
        <choice name="Image"/>
        <choice name="Arrow"/>
      </choices>
    </entry>
    <entry name="CapColor" type="Color">
      <!-- Also the fallback when the cap image is missing or broken. -->
      <default>#1b3fd8</default>
    </entry>
    <entry name="CapColor2" type="Color">
      <default>#0a1a5e</default>
    </entry>
    <entry name="CapGradientType" type="Enum">
      <default>LinearVertical</default>
      <choices>
        <choice name="LinearVertical"/>
        <choice name="LinearHorizontal"/>
        <choice name="Radial"/>
      </choices>
    </entry>
    <entry name="CapGradientStop" type="Int">
      <default>50</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="CapImage" type="Url">
      <!-- Local file only (file: or a bare path); remote URLs are
                 dropped by constants.js capImageSource(). -->
      <default/>
    </entry>
    <entry name="CapImageFit" type="Enum">
      <default>Cover</default>
      <choices>
        <choice name="Cover"/>
        <choice name="Contain"/>
        <choice name="Stretch"/>
      </choices>
    </entry>
    <entry name="CapOpacity" type="Int">
      <default>80</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <!-- Window layers (ADR-028 model H as amended 2026-11-27): each window
             of a face becomes a quad pushed OUTWARDS (+z, the face normal)
             by its stacking rank, and the face grab keeps
             a transparent hole exactly where that window was (the plate at
             z = -2 veils the holes). No new enums
             (the KConfigXT integer rule): WindowLayerGap is an Int 0-600 px
             and WindowLayerPlateOpacity a plain Double 0-1 — the ranges are
             declared here for the KCM widgets AND re-resolved by
             layerGeometry.js, so a hand-edited kwinrc can only ever mean a
             valid depth step, a valid LOD face count (0 = all faces) and a
             valid plate alpha. WindowLayering defaults FALSE: pixel parity
             with the virgin cube (the caps' opt-in pattern, ADR-027).
             Appended last: the convention for new entries. -->
    <entry name="WindowLayering" type="Bool">
      <default>false</default>
    </entry>
    <entry name="WindowLayerGap" type="Int">
      <default>120</default>
      <min>0</min>
      <max>600</max>
    </entry>
    <entry name="WindowLayerLodFaces" type="Int">
      <default>1</default>
      <min>0</min>
      <max>8</max>
    </entry>
    <entry name="WindowLayerPlateOpacity" type="Double">
      <default>0.25</default>
      <min>0</min>
      <max>1</max>
    </entry>
    <!-- Interior model (ADR-029, doc/requerimientos.md 4.1): the user picks a
             3D file from their own disk and the effect loads it AS-IS at
             runtime with RuntimeLoader (QtQuick3D.AssetUtils) — no balsam
             step, no compiling, no downloads. ModelFile is a Url and stays
             LOCAL ONLY (file: or an absolute bare path, the same localSource
             filter as SkyBox/CapImage): the compositor must never fetch
             content when the effect activates. Empty = feature off, nothing
             is loaded and no node is created. Only .glb/.gltf/.obj reach the
             runtime loader (Qt supports nothing else there), so the KCM hint
             says it. ModelScale is a plain Double MULTIPLIER of the automatic
             bounds fit (the effect normalises the model to 60% of the inner
             height), so a model authored in metres and one authored in
             hundreds of units both land visible without the user doing math.
             Appended last: the convention for new entries. -->
    <entry name="ModelFile" type="Url">
      <default/>
    </entry>
    <entry name="ModelScale" type="Double">
      <default>1.0</default>
      <min>0.05</min>
      <max>50</max>
    </entry>
    <!-- WindowLayerRotationOpacity (ADR-028 amendment, the pile's own fade):
             the ABSOLUTE opacity of the layer quads while the cube turns.
             At rest the layers are always 1 (solid windows — the Mask
             threshold writes depth and the outermost rank wins overlaps by
             geometry, not by sort centroid). Resolved by
             layerGeometry.rotationOpacity then fed to the existing
             Constants.faceOpacity(1, v, cubeMoving) machinery (FaceFadeMs):
             same animation as the faces, zero new mechanism. Default 0.7
             EQUALS FaceRotationOpacity's default, so out of the box the
             pile fades exactly like the face; 1.0 keeps the windows solid
             AND depth-ordered while turning; with WindowLayering false the
             key is inert (no quads exist; the windows stay pixels of the
             grab and share the desktop's transparency). Appended last. -->
    <entry name="WindowLayerRotationOpacity" type="Double">
      <default>0.7</default>
      <min>0</min>
      <max>1</max>
    </entry>
    <!-- WindowLayerThickness / WindowLayerEdgeColor (ADR-028 fourth
             amendment, the simulated slab, FINAL design): each layer is
             ONE closed box (a shared ProceduralMesh with two material
             subsets: textured front, coloured sides + back, BackFaceCulling
             so nothing of the box's inside can leak - the first two-object
             design showed a giant black bezel through the thumbnail's
             transparent shadow margins, measured 2026-11-28). The
             thickness is an Int 0-300 px whose EFFECTIVE value is always
             clipped to half the fitted step (two layers can never
             intersect; layerGeometry.js thicknessEffective); default 24
             (measured 2026-11-28: 2 px built the box but the rim did not
             read - 24 finally looks like a solid at oblique angles) -
             the box spans the EXACT window rect (win.width x win.height),
             not the grab with its shadow margins, so no thickness becomes
             a bezel. 0 stays a real value: flat quad, pixel parity with
             the quad-only model. The
             edge colour is a plain Color entry (KColorButton in the
             Windows tab) sharing the plate's dark tone by default. Both
             live in Ventanas with the rest of the
             layering look; raw kwinrc strings cannot leak a bad colour:
             layerGeometry.edgeColor falls back to the schema default.
             Appended last: the convention for new entries. -->
    <entry name="WindowLayerThickness" type="Int">
      <default>24</default>
      <min>0</min>
      <max>300</max>
    </entry>
    <entry name="WindowLayerEdgeColor" type="Color">
      <default>#141719</default>
    </entry>
  </group>
</kcfg>
