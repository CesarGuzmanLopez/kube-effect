<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 Cesar Guzman
SPDX-License-Identifier: GPL-2.0-or-later

Formulario del KCM genérico (kcm_kwin4_genericscripted) para kube-effect.
Pestañas fijas (Shape & center, Background, Windows 3D, Appearance, Input,
Presets, Advanced); las que aún no tienen claves quedan vacías con un aviso,
hasta que la fase correspondiente del ROADMAP las rellene. Las opciones
avanzadas viven SOLO en Advanced (ADR-014), en grupos de lenguaje llano y con
una sección plegable de Kube Effect Plus (ADR-018). Cada widget = kcfg_<Entry>.
-->
<ui version="4.0">
    <class>KubeEffectConfigForm</class>
    <widget class="QWidget" name="KubeEffectConfigForm">
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>700</width>
                <height>520</height>
            </rect>
        </property>
        <layout class="QVBoxLayout" name="rootLayout">
            <item>
                <widget class="QLabel" name="versionLabel">
                    <property name="text">
                        <string>kube-effect 0.0.0.3</string>
                    </property>
                    <property name="alignment">
                        <set>Qt::AlignRight|Qt::AlignVCenter</set>
                    </property>
                    <property name="styleSheet">
                        <string notr="true">color: #888888; font-weight: bold;</string>
                    </property>
                </widget>
            </item>
            <item>
                <widget class="QTabWidget" name="tabs">
                    <property name="currentIndex">
                        <number>0</number>
                    </property>

                    <!-- 1. Shape & center -->
                    <widget class="QWidget" name="tabShape">
                        <attribute name="title">
                            <string>Shape</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabShapeLayout">
                            <item>
                                <widget class="QLabel" name="tabShapePlaceholder">
                                    <property name="text">
                                        <string>Forma e interior se añaden en fases posteriores (ver doc/requerimientos.md).</string>
                                    </property>
                                    <property name="wordWrap">
                                        <bool>true</bool>
                                    </property>
                                </widget>
                            </item>
                        </layout>
                    </widget>

                    <!-- 2. Background -->
                    <widget class="QWidget" name="tabBackground">
                        <attribute name="title">
                            <string>Background</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabBackgroundLayout">
                            <item>
                                <layout class="QFormLayout" name="bgModeForm">
                                    <item row="0" column="0">
                                        <widget class="QLabel" name="bgModeLabel">
                                            <property name="text">
                                                <string>Modo de fondo:</string>
                                            </property>
                                        </widget>
                                    </item>
                                    <item row="0" column="1">
                                        <widget class="QComboBox" name="kcfg_Background">
                                            <item>
                                                <property name="text">
                                                    <string>Color</string>
                                                </property>
                                            </item>
                                            <item>
                                                <property name="text">
                                                    <string>Imagen (Image)</string>
                                                </property>
                                            </item>
                                            <item>
                                                <property name="text">
                                                    <string>Degradado (Gradient)</string>
                                                </property>
                                            </item>
                                            <item>
                                                <property name="text">
                                                    <string>Vídeo (Video)</string>
                                                </property>
                                            </item>
                                        </widget>
                                    </item>
                                    <item row="1" column="0">
                                        <widget class="QLabel" name="bgColorLabel">
                                            <property name="text">
                                                <string>Color de fondo:</string>
                                            </property>
                                        </widget>
                                    </item>
                                    <item row="1" column="1">
                                        <!-- One KConfigXT entry binds exactly one widget, so
                                             the solid colour (also the first gradient stop and
                                             the image fallback) lives outside the stack. -->
                                        <widget class="KColorButton" name="kcfg_BackgroundColor" />
                                    </item>
                                </layout>
                            </item>
                            <item>
                                <!-- One page per mode, in Background enum order. The designer
                                     connection block at the end of this file switches pages; the
                                     generic KCM only loads this .ui with QUiLoader, so there is
                                     no config.qml logic to do it. -->
                                <widget class="QStackedWidget" name="bgModeStack">
                                    <property name="currentIndex">
                                        <number>0</number>
                                    </property>

                                    <!-- 0: Color -->
                                    <widget class="QWidget" name="bgColorPage">
                                        <layout class="QFormLayout" name="bgColorForm">
                                            <item row="0" column="0" colspan="2">
                                                <widget class="QLabel" name="bgColorHint">
                                                    <property name="text">
                                                        <string>Modo Color: se pinta el color de fondo de arriba.</string>
                                                    </property>
                                                    <property name="wordWrap">
                                                        <bool>true</bool>
                                                    </property>
                                                </widget>
                                            </item>
                                        </layout>
                                    </widget>

                                    <!-- 1: Image -->
                                    <widget class="QWidget" name="bgImagePage">
                                        <layout class="QFormLayout" name="bgImageForm">
                                            <item row="0" column="0">
                                                <widget class="QLabel" name="bgImageLabel">
                                                    <property name="text">
                                                        <string>Imagen de fondo (2:1 = panorama 360; foto normal = Plano):</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="0" column="1">
                                                <widget class="KUrlRequester" name="kcfg_SkyBox" />
                                            </item>
                                            <item row="1" column="0" colspan="2">
                                                <widget class="QLabel" name="bgImageHint">
                                                    <property name="text">
                                                        <string>Equirect envuelve la escena como SkyBox (con «Girar con el centro») o la pinta plana si se desactiva. El ajuste se aplica a la imagen plana (incluye el equirect sin girar).</string>
                                                    </property>
                                                    <property name="wordWrap">
                                                        <bool>true</bool>
                                                    </property>
                                                </widget>
                                            </item>
                                        </layout>
                                    </widget>

                                    <!-- 2: Gradient -->
                                    <widget class="QWidget" name="bgGradientPage">
                                        <layout class="QFormLayout" name="bgGradientForm">
                                            <item row="0" column="0">
                                                <widget class="QLabel" name="bgGradientTypeLabel">
                                                    <property name="text">
                                                        <string>Tipo de degradado:</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="0" column="1">
                                                <widget class="QComboBox" name="kcfg_BackgroundGradientType">
                                                    <item>
                                                        <property name="text">
                                                            <string>Vertical (LinearVertical)</string>
                                                        </property>
                                                    </item>
                                                    <item>
                                                        <property name="text">
                                                            <string>Horizontal (LinearHorizontal)</string>
                                                        </property>
                                                    </item>
                                                    <item>
                                                        <property name="text">
                                                            <string>Radial</string>
                                                        </property>
                                                    </item>
                                                </widget>
                                            </item>
                                            <item row="1" column="0">
                                                <widget class="QLabel" name="bgColor2Label">
                                                    <property name="text">
                                                        <string>Segundo color:</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="1" column="1">
                                                <widget class="KColorButton" name="kcfg_BackgroundColor2" />
                                            </item>
                                            <item row="2" column="0">
                                                <widget class="QLabel" name="bgStopLabel">
                                                    <property name="text">
                                                        <string>Posición del degradado:</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="2" column="1">
                                                <widget class="QSpinBox" name="kcfg_BackgroundGradientStop">
                                                    <property name="minimum">
                                                        <number>0</number>
                                                    </property>
                                                    <property name="maximum">
                                                        <number>100</number>
                                                    </property>
                                                    <property name="suffix">
                                                        <string> %</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="3" column="0">
                                                <widget class="QLabel" name="bgGradientRotationLabel">
                                                    <property name="text">
                                                        <string>Orientación del fondo:</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="3" column="1">
                                                <widget class="QComboBox" name="kcfg_BackgroundGradientRotation">
                                                    <item>
                                                        <property name="text">
                                                            <string>Fija (Fixed)</string>
                                                        </property>
                                                    </item>
                                                    <item>
                                                        <property name="text">
                                                            <string>Seguir al cubo (FollowCube)</string>
                                                        </property>
                                                    </item>
                                                    <item>
                                                        <property name="text">
                                                            <string>Seguir al cubo, invertido (FollowCubeInverse)</string>
                                                        </property>
                                                    </item>
                                                </widget>
                                            </item>
                                            <item row="4" column="0" colspan="2">
                                                <widget class="QLabel" name="bgGradientHint">
                                                    <property name="text">
                                                        <string>El primer color es el color de fondo de arriba. El tipo Radial se dibuja centrado en la pantalla con QtQuick.Shapes (sin shaders). La orientación solo afecta al degradado: «Fixed» lo deja quieto; «FollowCube» gira el degradado con el cubo y «FollowCubeInverse» en sentido contrario; con Radial se mueve el punto focal, porque girar un radial centrado no se nota.</string>
                                                    </property>
                                                    <property name="wordWrap">
                                                        <bool>true</bool>
                                                    </property>
                                                </widget>
                                            </item>
                                        </layout>
                                    </widget>

                                    <!-- 3: Video -->
                                    <widget class="QWidget" name="bgVideoPage">
                                        <layout class="QFormLayout" name="bgVideoForm">
                                            <item row="0" column="0">
                                                <widget class="QLabel" name="bgVideoLabel">
                                                    <property name="text">
                                                        <string>Vídeo de fondo:</string>
                                                    </property>
                                                </widget>
                                            </item>
                                            <item row="0" column="1">
                                                <widget class="KUrlRequester" name="kcfg_BackgroundVideo" />
                                            </item>
                                            <item row="1" column="0" colspan="2">
                                                <widget class="QLabel" name="bgVideoHint">
                                                    <property name="text">
                                                        <string>MP4/WebM; 2:1 = panorámica 360. Usa el mapeo, el ajuste y el giro de la sección «Imagen o vídeo» de abajo. Necesita el módulo QtMultimedia; si no está instalado, se pinta el color de fondo.</string>
                                                    </property>
                                                    <property name="wordWrap">
                                                        <bool>true</bool>
                                                    </property>
                                                </widget>
                                            </item>
                                        </layout>
                                    </widget>
                                </widget>
                            </item>
                            <item>
                                <!-- One KConfigXT entry = one widget, and the image and
                                     the video share these three keys, so they live
                                     outside the stack instead of being duplicated
                                     inside both pages. -->
                                <widget class="QGroupBox" name="bgPictureGroup">
                                    <property name="title">
                                        <string>Imagen o vídeo: cómo se muestra</string>
                                    </property>
                                    <layout class="QFormLayout" name="bgPictureForm">
                                        <item row="0" column="0">
                                            <widget class="QLabel" name="bgImageMappingLabel">
                                                <property name="text">
                                                    <string>Mapeo (imagen o vídeo):</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="0" column="1">
                                            <widget class="QComboBox" name="kcfg_BackgroundImageLayout">
                                                <item>
                                                    <property name="text">
                                                        <string>Equirect (360)</string>
                                                    </property>
                                                </item>
                                                <item>
                                                    <property name="text">
                                                        <string>Plano (Flat)</string>
                                                    </property>
                                                </item>
                                            </widget>
                                        </item>
                                        <item row="1" column="0">
                                            <widget class="QLabel" name="bgImageFitLabel">
                                                <property name="text">
                                                    <string>Ajuste de lo que va plano:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="1" column="1">
                                            <widget class="QComboBox" name="kcfg_BackgroundImageFit">
                                                <item>
                                                    <property name="text">
                                                        <string>Cubrir (Cover)</string>
                                                    </property>
                                                </item>
                                                <item>
                                                    <property name="text">
                                                        <string>Contener (Contain)</string>
                                                    </property>
                                                </item>
                                                <item>
                                                    <property name="text">
                                                        <string>Estirar (Stretch)</string>
                                                    </property>
                                                </item>
                                            </widget>
                                        </item>
                                        <item row="2" column="0" colspan="2">
                                            <widget class="QCheckBox" name="kcfg_BackgroundImageRotate">
                                                <property name="text">
                                                    <string>Girar con el centro (solo 360)</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="3" column="0" colspan="2">
                                            <widget class="QLabel" name="bgPictureHint">
                                                <property name="text">
                                                    <string>Con Equirect y «Girar con el centro» la imagen o el vídeo envuelven la escena (360) y giran con el cubo; si se desactiva el giro, o el mapeo es Plano, se pintan como capa plana con el ajuste de arriba.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                        </layout>
                    </widget>

                    <!-- 3. Windows 3D -->
                    <widget class="QWidget" name="tabWindows">
                        <attribute name="title">
                            <string>Windows</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabWindowsLayout">
                            <item>
                                <widget class="QLabel" name="tabWindowsPlaceholder">
                                    <property name="text">
                                        <string>Capas de ventana (z-index) en una fase posterior (ver doc/requerimientos.md).</string>
                                    </property>
                                    <property name="wordWrap">
                                        <bool>true</bool>
                                    </property>
                                </widget>
                            </item>
                        </layout>
                    </widget>

                    <!-- 4. Appearance -->
                    <widget class="QWidget" name="tabAppearance">
                        <attribute name="title">
                            <string>Appearance</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabAppearanceLayout">
                            <item>
                                <widget class="QGroupBox" name="appGroup">
                                    <property name="title">
                                        <string>Geometría</string>
                                    </property>
                                    <layout class="QFormLayout" name="appForm">
                                        <item row="0" column="0">
                                            <widget class="QLabel" name="dispLabel">
                                                <property name="text">
                                                    <string>Separación entre caras (px):</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="0" column="1">
                                            <widget class="QDoubleSpinBox" name="kcfg_CubeFaceDisplacement">
                                                <property name="minimum">
                                                    <double>-500.0</double>
                                                </property>
                                                <property name="maximum">
                                                    <double>500.0</double>
                                                </property>
                                                <property name="singleStep">
                                                    <double>10.0</double>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="1" column="0">
                                            <widget class="QLabel" name="distLabel">
                                                <property name="text">
                                                    <string>Distancia de la cámara:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="1" column="1">
                                            <widget class="QDoubleSpinBox" name="kcfg_DistanceFactor">
                                                <property name="minimum">
                                                    <double>0.5</double>
                                                </property>
                                                <property name="maximum">
                                                    <double>5.0</double>
                                                </property>
                                                <property name="singleStep">
                                                    <double>0.1</double>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                            <item>
                                <!-- Face transparency (ADR-021): material opacity,
                                     inherited unchanged by the future cylinder. -->
                                <widget class="QGroupBox" name="faceOpacityGroup">
                                    <property name="title">
                                        <string>Caras (transparencia)</string>
                                    </property>
                                    <layout class="QFormLayout" name="faceOpacityForm">
                                        <item row="0" column="0">
                                            <widget class="QLabel" name="faceOpacityLabel">
                                                <property name="text">
                                                    <string>Opacidad en reposo:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="0" column="1">
                                            <widget class="QDoubleSpinBox" name="kcfg_FaceOpacity">
                                                <property name="minimum">
                                                    <double>0.1</double>
                                                </property>
                                                <property name="maximum">
                                                    <double>1.0</double>
                                                </property>
                                                <property name="singleStep">
                                                    <double>0.05</double>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="1" column="0">
                                            <widget class="QLabel" name="faceRotationOpacityLabel">
                                                <property name="text">
                                                    <string>Opacidad mientras gira:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="1" column="1">
                                            <widget class="QDoubleSpinBox" name="kcfg_FaceRotationOpacity">
                                                <property name="minimum">
                                                    <double>0.1</double>
                                                </property>
                                                <property name="maximum">
                                                    <double>1.0</double>
                                                </property>
                                                <property name="singleStep">
                                                    <double>0.05</double>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="2" column="0">
                                            <widget class="QLabel" name="faceFadeLabel">
                                                <property name="text">
                                                    <string>Fundido (ms):</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="2" column="1">
                                            <widget class="QSpinBox" name="kcfg_FaceFadeMs">
                                                <property name="minimum">
                                                    <number>0</number>
                                                </property>
                                                <property name="maximum">
                                                    <number>1000</number>
                                                </property>
                                                <property name="singleStep">
                                                    <number>10</number>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="3" column="0" colspan="2">
                                            <widget class="QLabel" name="faceOpacityHint">
                                                <property name="text">
                                                    <string>Con la opacidad de giro por debajo de 1 las caras se vuelven semitransparentes mientras el cubo gira (se ve el fondo y las caras de detrás) y vuelven a la opacidad de reposo al parar. No afecta al oscurecido del fondo (Advanced).</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                        </layout>
                    </widget>

                    <!-- 5. Input -->
                    <widget class="QWidget" name="tabInput">
                        <attribute name="title">
                            <string>Input</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabInputLayout">
                            <item>
                                <widget class="QGroupBox" name="inputGroup">
                                    <property name="title">
                                        <string>Activación</string>
                                    </property>
                                    <layout class="QFormLayout" name="inputForm">
                                        <item row="0" column="0">
                                            <widget class="QLabel" name="borderLabel">
                                                <property name="text">
                                                    <string>Bordes (puntero), p. ej. 1,7:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="0" column="1">
                                            <widget class="QLineEdit" name="kcfg_BorderActivate" />
                                        </item>
                                        <item row="1" column="0">
                                            <widget class="QLabel" name="touchLabel">
                                                <property name="text">
                                                    <string>Bordes (toque), p. ej. 5:</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="1" column="1">
                                            <widget class="QLineEdit" name="kcfg_TouchBorderActivate" />
                                        </item>
                                        <item row="2" column="0" colspan="2">
                                            <widget class="QCheckBox" name="kcfg_MouseInvertedX">
                                                <property name="text">
                                                    <string>Invertir eje X del ratón</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item row="3" column="0" colspan="2">
                                            <widget class="QCheckBox" name="kcfg_MouseInvertedY">
                                                <property name="text">
                                                    <string>Invertir eje Y del ratón</string>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                            <item>
                                <widget class="QGroupBox" name="shortcutGroup">
                                    <property name="title">
                                        <string>Atajo de teclado</string>
                                    </property>
                                    <layout class="QVBoxLayout" name="shortcutLayout">
                                        <item>
                                            <widget class="QLabel" name="shortcutHint">
                                                <property name="text">
                                                    <string>Se cambia en Preferencias del sistema → Atajos de teclado → KWin → «Toggle Kube Effect» (Meta+K por defecto). KWin guarda el atajo con KGlobalAccel; por eso no se duplica aquí.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                        </layout>
                    </widget>

                    <!-- 6. Presets -->
                    <widget class="QWidget" name="tabPresets">
                        <attribute name="title">
                            <string>Presets</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabPresetsLayout">
                            <item>
                                <widget class="QLabel" name="tabPresetsPlaceholder">
                                    <property name="text">
                                        <string>Presets en una fase posterior (ver doc/requerimientos.md).</string>
                                    </property>
                                    <property name="wordWrap">
                                        <bool>true</bool>
                                    </property>
                                </widget>
                            </item>
                        </layout>
                    </widget>

                    <!-- 7. Advanced: the only place for advanced options (ADR-014) -->
                    <widget class="QWidget" name="tabAdvanced">
                        <attribute name="title">
                            <string>Advanced</string>
                        </attribute>
                        <layout class="QVBoxLayout" name="tabAdvancedLayout">
                            <item>
                                <widget class="QGroupBox" name="advancedDimGroup">
                                    <property name="title">
                                        <string>Atenuar mientras gira</string>
                                    </property>
                                    <layout class="QVBoxLayout" name="advancedDimLayout">
                                        <item>
                                            <widget class="QCheckBox" name="kcfg_DimWhileRotating">
                                                <property name="text">
                                                    <string>Atenuar el fondo mientras gira</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item>
                                            <widget class="QLabel" name="advancedDimHint">
                                                <property name="text">
                                                    <string>Oscurece el fondo del cubo mientras lo giras para que las ventanas destaquen; al soltar vuelve a la normalidad.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                        <item>
                                            <layout class="QFormLayout" name="advancedDimForm">
                                                <item row="0" column="0">
                                                    <widget class="QLabel" name="dimAmountLabel">
                                                        <property name="text">
                                                            <string>Intensidad de la atenuación:</string>
                                                        </property>
                                                    </widget>
                                                </item>
                                                <item row="0" column="1">
                                                    <widget class="QSpinBox" name="kcfg_DimWhileRotatingAmount">
                                                        <property name="enabled">
                                                            <bool>false</bool>
                                                        </property>
                                                        <property name="minimum">
                                                            <number>0</number>
                                                        </property>
                                                        <property name="maximum">
                                                            <number>100</number>
                                                        </property>
                                                        <property name="suffix">
                                                            <string> %</string>
                                                        </property>
                                                    </widget>
                                                </item>
                                            </layout>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                            <item>
                                <widget class="QFrame" name="advancedSeparator1">
                                    <property name="frameShape">
                                        <enum>QFrame::HLine</enum>
                                    </property>
                                    <property name="frameShadow">
                                        <enum>QFrame::Sunken</enum>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <widget class="QGroupBox" name="advancedScreenGroup">
                                    <property name="title">
                                        <string>Pantalla</string>
                                    </property>
                                    <layout class="QVBoxLayout" name="advancedScreenLayout">
                                        <item>
                                            <widget class="QCheckBox" name="kcfg_CursorScreenOnly">
                                                <property name="text">
                                                    <string>Mostrar el cubo solo en la pantalla donde está el puntero</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item>
                                            <widget class="QLabel" name="advancedScreenHint">
                                                <property name="text">
                                                    <string>Si mueves el puntero después de abrirlo, el cubo se queda en la pantalla donde lo abriste hasta la próxima vez.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                            <item>
                                <widget class="QFrame" name="advancedSeparator2">
                                    <property name="frameShape">
                                        <enum>QFrame::HLine</enum>
                                    </property>
                                    <property name="frameShadow">
                                        <enum>QFrame::Sunken</enum>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <widget class="QGroupBox" name="advancedVideoGroup">
                                    <property name="title">
                                        <string>Vídeo de fondo (opcional)</string>
                                    </property>
                                    <layout class="QVBoxLayout" name="advancedVideoLayout">
                                        <item>
                                            <widget class="QLabel" name="advancedVideoHint">
                                                <property name="text">
                                                    <string>El vídeo necesita el módulo QtMultimedia (paquete qt6-multimedia en Arch). Si no está instalado, el vídeo se sustituye por el color de respaldo.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                            <item>
                                <widget class="QFrame" name="advancedSeparator3">
                                    <property name="frameShape">
                                        <enum>QFrame::HLine</enum>
                                    </property>
                                    <property name="frameShadow">
                                        <enum>QFrame::Sunken</enum>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <widget class="QCheckBox" name="showPlusSection">
                                    <property name="text">
                                        <string>¿Quieres funciones extra? (Kube Effect Plus)</string>
                                    </property>
                                </widget>
                            </item>
                            <item>
                                <widget class="QGroupBox" name="plusSection">
                                    <property name="visible">
                                        <bool>false</bool>
                                    </property>
                                    <property name="title">
                                        <string>Funciones extra (Kube Effect Plus)</string>
                                    </property>
                                    <layout class="QVBoxLayout" name="plusSectionLayout">
                                        <item>
                                            <widget class="QLabel" name="plusIntro">
                                                <property name="text">
                                                    <string>Kube Effect Plus aún no añade funciones; aquí aparecerán cuando exista alguna que el efecto no pueda hacer por sí solo.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                        <item>
                                            <widget class="QPlainTextEdit" name="plusCommands">
                                                <property name="font">
                                                    <font>
                                                        <family>Monospace</family>
                                                        <pointsize>10</pointsize>
                                                    </font>
                                                </property>
                                                <property name="lineWrapMode">
                                                    <enum>QPlainTextEdit::NoWrap</enum>
                                                </property>
                                                <property name="readOnly">
                                                    <bool>true</bool>
                                                </property>
                                                <property name="plainText">
                                                    <string>cd ~/.local/share/kwin/effects/kube-effect/contents/native
./build.sh            # solo para tu usuario
./build.sh --system   # aparece en Preferencias (pide contraseña)</string>
                                                </property>
                                            </widget>
                                        </item>
                                        <item>
                                            <widget class="QLabel" name="plusRepoNote">
                                                <property name="text">
                                                    <string>Si compilaste desde el repositorio, «make native» y «make native-install» equivalen.</string>
                                                </property>
                                                <property name="wordWrap">
                                                    <bool>true</bool>
                                                </property>
                                            </widget>
                                        </item>
                                    </layout>
                                </widget>
                            </item>
                        </layout>
                    </widget>
                </widget>
            </item>
        </layout>
    </widget>
    <customwidgets>
        <customwidget>
            <class>KColorButton</class>
            <extends>QPushButton</extends>
            <header>kcolorbutton.h</header>
        </customwidget>
        <customwidget>
            <class>KUrlRequester</class>
            <extends>QWidget</extends>
            <header>kurlrequester.h</header>
        </customwidget>
    </customwidgets>
    <connections>
        <!-- The generic KCM loads this form with QUiLoader and has no logic of
             its own; a designer connection is the only way to react to the mode
             combo. QUiLoader recreates it, so no C++ or config.qml is needed. -->
        <connection>
            <sender>kcfg_Background</sender>
            <signal>currentIndexChanged(int)</signal>
            <receiver>bgModeStack</receiver>
            <slot>setCurrentIndex(int)</slot>
        </connection>
        <!-- The dim amount only means something when dimming is on: start
             disabled and follow the checkbox (KConfigDialogManager applies the
             saved value with setChecked, so toggled() fires on load too). -->
        <connection>
            <sender>kcfg_DimWhileRotating</sender>
            <signal>toggled(bool)</signal>
            <receiver>kcfg_DimWhileRotatingAmount</receiver>
            <slot>setEnabled(bool)</slot>
        </connection>
        <!-- The Plus block is opt-in: hidden until the user asks for it. -->
        <connection>
            <sender>showPlusSection</sender>
            <signal>toggled(bool)</signal>
            <receiver>plusSection</receiver>
            <slot>setVisible(bool)</slot>
        </connection>
    </connections>
</ui>
