// The cap mesh holder (ADR-027): ONE flat ProceduralMesh for the top and the
// bottom cap of the solid.
//
// This is the ONLY file of the effect importing QtQuick3D.Helpers for the
// caps, and Cube.qml reaches it through a Loader source URL (active only
// while at least one cap is enabled and the solid is not the flat sheet), so
// the file is compiled at RUNTIME: a system without the module fails only
// this Loader — Cube.capMesh stays null, both caps stay hidden and the cube
// renders exactly as before (the CylinderArcMesh.qml / HullVideo.qml
// isolation pattern of ADR-022/ADR-025). The root is a zero-size holder Item
// because a Loader can only load Item-based components; the geometry it
// exposes is a plain ProceduralMesh referenced by both Cap Models.
//
// The shape switches on `useDisc` without ever creating a second mesh: the
// polygon cap (face-corner ring: the inscribed N-gon while the faces touch,
// the N face-corner pairs closed by straight gap chords once
// CubeFaceDisplacement separates them — ADR-027 amendment) or the drum cap
// (disc, radius = cylinderRadius, CYLINDER_SEGMENTS like the arc). Both are
// generated by the PURE generators in capGeometry.js (capPolygonGeometry /
// capDiscGeometry), which is what scripts/check-cap.py validates offscreen
// without KWin or a window: y = 0 vertices, +Y normals, CCW winding seen
// from +Y, centred UVs, and no vertex outside the face planes or the face
// corners. The bottom cap is the SAME geometry on a node rotated 180 deg
// (ADR-027: no second mesh, no mirrored copy), so the arrays below are
// rebuilt only when (useDisc, apothem, faceWidth, sides, radius, halfHeight)
// change — never per frame.

import QtQuick
import QtQuick3D.Helpers

import "constants.js" as Constants
import "capGeometry.js" as CapGeometry

Item {
  id: capHolder

  visible: false
  width: 0
  height: 0

  // The numbers that define the cap (bound by Cube.qml through the Loader).
  // Polygon branch: sides + apothem + faceWidth (apothem IS Cube.faceDistance,
  // the one geometric source). faceWidth IS Cube.faceSize.width: the input
  // the ring needed until the ADR-027 amendment — without it the generator
  // can only follow the face PLANES and grows tangential tips past the face
  // corners whenever the faces are separated (displacement > 0).
  // Disc branch: radius (IS Cube.cylinderRadius) with the arc's fixed
  // segment count. halfHeight gates the mesh: while the face size has not
  // settled the cap has no plane to sit on and must render nothing.
  property int sides: 4
  property real apothem: 0
  property real faceWidth: 0
  property real radius: 0
  property real halfHeight: 0
  property int segments: Constants.CYLINDER_SEGMENTS
  // True with the cylinder drum in effect (disc), false for the polygon
  // (N-gon). Follows cube.cylinderActive, so the cap silhouette always
  // matches the solid the faces actually render.
  property bool useDisc: false

  // Recomputed only when the inputs above change: one object with the four
  // arrays, so the mesh properties below read slices of it without ever
  // re-running the trigonometry (the CylinderArcMesh pattern).
  readonly property var capGeometry: useDisc ? CapGeometry.capDiscGeometry(radius, segments, halfHeight) : CapGeometry.capPolygonGeometry(apothem, faceWidth, sides, halfHeight)

  property ProceduralMesh mesh: ProceduralMesh {
    primitiveMode: ProceduralMesh.Triangles
    positions: capHolder.capGeometry.positions
    normals: capHolder.capGeometry.normals
    uv0s: capHolder.capGeometry.uvs
    indexes: capHolder.capGeometry.indexes
  }
}
