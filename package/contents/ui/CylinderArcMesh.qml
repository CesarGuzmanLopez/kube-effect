// The cylinder arc mesh (Shape == Cylinder, ADR-025).
//
// This is the ONLY file of the effect importing QtQuick3D.Helpers, and
// Cube.qml reaches it through a Loader source URL (active only in cylinder
// mode), so the file is compiled at RUNTIME: a system without the module
// fails only this Loader — item stays null, Cube.cylinderMesh stays null,
// cylinderActive turns false and the faces keep the flat built-in
// #Rectangle, degrading the solid to the polygon formulas instead of
// losing the effect (the HullVideo.qml / HullRadial.qml isolation pattern
// of ADR-022). The root is a zero-size holder Item because a Loader can
// only load Item-based components; the geometry it exposes is a plain
// ProceduralMesh, referenced by every Model.geometry (shared mesh).
//
// The arc is generated by the PURE cylinderArcGeometry() in constants.js —
// positions on radius R, radial normals, isometric UVs (u = s/W, v = t/H
// with the #Rectangle bottom-left origin), CCW winding seen from outside —
// which is what scripts/check-cylinder.py validates offscreen without KWin
// or a window. The arrays are bound, so the mesh is rebuilt only when
// (faceWidth, faceHeight, radius) change: turning and zooming never touch
// it.
//
// ONE instance is shared by all faces: every CubeFace (Model) references
// mesh through Model.geometry, exactly like the shared built-in primitives.
// The arc is generated around the node (mid-point at the origin, drum axis
// at (0, 0, -R)), so a face differs from the next only by the polygon's own
// placement: position = rotate(azimuth) * (0, 0, R) plus eulerRotation.y —
// distinct sort centroids per face, ADR-026.

import QtQuick
import QtQuick3D.Helpers

import "constants.js" as Constants

Item {
    id: arcHolder

    visible: false
    width: 0
    height: 0

    // The three numbers that define the arc (bound by Cube.qml through the
    // Loader: a screen resize or a config change re-runs the generator,
    // nothing else does) and the fixed segment count (ADR-002: 32-64, 64
    // chosen for large arcs and close-up zoom).
    property real faceWidth: 1
    property real faceHeight: 1
    property real radius: 0
    property int segments: Constants.CYLINDER_SEGMENTS

    // Recomputed only when the inputs above change: one object with the
    // four arrays (130 vertices, 384 indexes), so the mesh properties below
    // read slices of it without ever re-running the trigonometry.
    readonly property var arcGeometry: Constants.cylinderArcGeometry(faceWidth, faceHeight, radius, segments)

    property ProceduralMesh mesh: ProceduralMesh {
        primitiveMode: ProceduralMesh.Triangles
        positions: arcHolder.arcGeometry.positions
        normals: arcHolder.arcGeometry.normals
        uv0s: arcHolder.arcGeometry.uvs
        indexes: arcHolder.arcGeometry.indexes
    }
}
